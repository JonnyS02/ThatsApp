<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import io.github.palexdev.materialfx.controls.MFXTextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox prefHeight="250.0" prefWidth="410.0" styleClass="dialog-root, pad-base" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="thatsapp.client.ui.controllers.ChangeBackgroundController">
    <Label styleClass="text-title, text-title-standard" text="Change Background"/>
    <Separator styleClass="modal-separator"/>
    <HBox alignment="CENTER" spacing="10.0">
        <MFXTextField fx:id="pathField" editable="false" floatingText="Image File Path" maxWidth="1.7976931348623157E308" styleClass="rounded-input" HBox.hgrow="ALWAYS"/>
        <MFXButton buttonType="RAISED" depthLevel="LEVEL1" onAction="#browse" styleClass="button-primary, button-spacious" text="">
            <graphic>
                <FontIcon iconLiteral="fltral-folder-open-20" styleClass="icon-lg"/>
            </graphic>
        </MFXButton>
    </HBox>
    <Separator styleClass="modal-separator"/>
    <HBox>
        <HBox spacing="10.0" HBox.hgrow="ALWAYS">
            <MFXButton fx:id="applyButton" buttonType="RAISED" depthLevel="LEVEL1" onAction="#apply" styleClass="button-primary, button-spacious" text="Apply"/>
            <MFXButton buttonType="RAISED" depthLevel="LEVEL1" onAction="#close" styleClass="button-spacious" text="Cancel"/>
        </HBox>
        <MFXButton buttonType="RAISED" depthLevel="LEVEL1" onAction="#remove" styleClass="button-danger, button-spacious" text="Remove"/>
    </HBox>
</VBox>
