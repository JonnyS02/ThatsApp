<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import io.github.palexdev.materialfx.controls.MFXPasswordField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="380.0" prefWidth="330.0" styleClass="dialog-root, pad-base" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="thatsapp.client.ui.controllers.ChangePasswordController">
    <Label styleClass="text-title, text-title-standard" text="Change Password"/>
    <Separator styleClass="modal-separator"/>
    <MFXPasswordField fx:id="passwordField" allowCopy="true" allowCut="true" allowPaste="true" floatingText="Password" maxWidth="1.7976931348623157E308" styleClass="rounded-input"/>
    <MFXPasswordField fx:id="repeatPasswordField" allowCopy="true" allowCut="true" allowPaste="true" floatingText="Repeat Password" maxWidth="1.7976931348623157E308" styleClass="rounded-input"/>
    <Separator styleClass="modal-separator"/>
    <HBox alignment="CENTER" spacing="10.0">
        <MFXButton buttonType="RAISED" depthLevel="LEVEL1" onAction="#changePassword" styleClass="button-primary, button-spacious" text="Change"/>
        <MFXButton buttonType="RAISED" depthLevel="LEVEL1" onAction="#close" styleClass="button-spacious" text="Cancel"/>
    </HBox>
</VBox>
